[2026-02-19 21:42:11] local.INFO: SQL {"query":"select `persona`.`uid`, `car`.`descripcion` as `carrera`, `ciclos`.`grupo`, CONCAT(
                                persona.primerApellido,' ',
                                persona.segundoApellido,' ',
                                persona.nombre
                            ) AS nombre, 
                                IFNULL(SUM(
                                    CASE WHEN e.tipomovto = 'C'
                                    THEN e.importe ELSE 0 END
                                ),0)
                                -
                                IFNULL(SUM(
                                    CASE 
                                        WHEN e.tipomovto = 'A'
                                        AND e.idServicio IN (
                                            ct.idServicioInscripcion,
                                            ct.idServicioColegiatura,
                                            ct.idServicioRecargo,
                                            ct.idServicioBeca,
                                            ct.idServicioNotaCredito,
                                            ct.idServicioTraspasoSaldos1
                                        )
                                    THEN e.importe ELSE 0 END
                                ),0)
                                AS saldo
                             from `alumno` inner join `persona` on `persona`.`uid` = `alumno`.`uid` inner join `carrera` as `car` on `car`.`idNivel` = `alumno`.`idNivel` and `car`.`idCarrera` = `alumno`.`idCarrera` inner join `configuracionTesoreria` as `ct` on `ct`.`idNivel` = `alumno`.`idNivel` left join `ciclos` on `ciclos`.`uid` = `alumno`.`uid` and `ciclos`.`secuencia` = `alumno`.`secuencia` and `ciclos`.`idPeriodo` = ? left join `edocta` as `e` on `e`.`uid` = `alumno`.`uid` and `e`.`secuencia` = `alumno`.`secuencia` and `e`.`idPeriodo` = ? left join `servicio` as `s` on `s`.`idServicio` = `e`.`idServicio` and `s`.`tipoEdoCta` = ? where `alumno`.`idNivel` = ? group by `alumno`.`uid`, `persona`.`primerApellido`, `persona`.`segundoApellido`, `persona`.`nombre`, `car`.`descripcion`, `ciclos`.`grupo` having saldo > 0","bindings":[111,111,1,"5"]} 
